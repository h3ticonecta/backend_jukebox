SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# backendjukebox-dev.up.railway.app já entra via DEFAULT_DEPLOY_HOSTS em config/settings.py.

# Domínio próprio no Railway (ex.: paineljukebox.h3ti.com.br), separados por vírgula.
# Equivale a acrescentar cada host em ALLOWED_HOSTS e https://<host>/ em CSRF_TRUSTED_ORIGINS.
# EXTRA_ALLOWED_HOSTS=paineljukebox.h3ti.com.br

# CSRF (origens completas com esquema; use https em produção)
# CSRF_TRUSTED_ORIGINS=https://paineljukebox.h3ti.com.br

# CORS (origens do frontend, separadas por vírgula)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://frontend-dev.up.railway.app

# PostgreSQL (Railway injeta DATABASE_URL ao vincular o Postgres ao backend)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Mercado Pago (PIX) — opcional se cadastrar conta no Admin → Pagamentos
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_NOTIFICATION_URL=https://paineljukebox.h3ti.com.br/api/v1/pagamentos/webhook/mercadopago/
# MERCADOPAGO_WEBHOOK_BASE_URL=https://paineljukebox.h3ti.com.br

# Superusuário (criado/atualizado automaticamente no deploy do Railway)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Bucket: configure pelo Django Admin (/admin/) ou API (/api/v1/buckets/)
# As credenciais ficam salvas no PostgreSQL e persistem entre deploys.