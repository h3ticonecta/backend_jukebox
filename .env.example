SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origens do frontend, separadas por vírgula)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://frontend-dev.up.railway.app

# PostgreSQL (Railway injeta DATABASE_URL ao vincular o Postgres ao backend)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Superusuário (criado/atualizado automaticamente no deploy do Railway)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Bucket R2 (criado/atualizado automaticamente no deploy do Railway)
BUCKET_CONFIG_NAME=jukebox-prod
BUCKET_PROVIDER=cloudflare_r2
BUCKET_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
BUCKET_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
BUCKET_NAME=jukebox
BUCKET_ACCESS_KEY_ID=your-access-key
BUCKET_SECRET_ACCESS_KEY=your-secret-key
BUCKET_REGION_NAME=auto
BUCKET_MUSIC_ROOT_PREFIX=jukebox/Musicas/