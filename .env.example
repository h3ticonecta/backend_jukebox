SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origens do frontend, separadas por vírgula)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://frontend-dev.up.railway.app

# PostgreSQL (Railway injeta DATABASE_URL ao vincular o Postgres ao backend)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Superusuário (criado/atualizado automaticamente no deploy do Railway)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Bucket: configure pelo Django Admin (/admin/) ou API (/api/v1/buckets/)
# As credenciais ficam salvas no PostgreSQL e persistem entre deploys.